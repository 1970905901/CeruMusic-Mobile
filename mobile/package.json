{
  "name": "ceru-music-mobile",
  "version": "2.3.7",
  "private": true,
  "description": "Ceru Music mobile port for iOS 14+ and Android (arm64)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android",
    "cap:ios": "npm run build && cap sync ios",
    "android:debug": "npm run cap:android && cd android && gradlew.bat assembleDebug",
    "android:release": "npm run cap:android && cd android && gradlew.bat assembleRelease",
    "ios:sync": "npm run cap:ios",
    "assets": "capacitor-assets generate",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "7.0.5",
    "@capacitor/clipboard": "7.0.4",
    "@capacitor/core": "7.6.9",
    "@capacitor/device": "7.0.5",
    "@capacitor/filesystem": "7.1.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/local-notifications": "7.0.7",
    "@capacitor/network": "7.0.4",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/share": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@capacitor/toast": "7.0.4",
    "@capgo/capacitor-media-session": "7.3.0",
    "@ionic/vue": "8.8.19",
    "@ionic/vue-router": "8.8.19",
    "@logto/capacitor": "4.1.1",
    "@shiqianjiang/ceru-plugin-sdk": "0.3.14",
    "browser-id3-writer": "6.4.0",
    "crypto-js": "4.2.0",
    "fflate": "0.8.2",
    "idb": "8.0.4",
    "ionicons": "7.4.0",
    "json5": "2.2.3",
    "lodash-es": "4.18.1",
    "music-metadata-browser": "2.5.11",
    "pinia": "3.0.3",
    "socket.io-client": "^4.8.1",
    "vue": "3.5.21",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@types/crypto-js": "4.2.2",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "happy-dom": "21.0.3",
    "sass": "1.90.0",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "3.2.7",
    "vue-tsc": "3.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
